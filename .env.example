# Token do bot (Bot User OAuth Token), começa com xoxb-
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Signing secret do app (Basic Information > App Credentials)
SLACK_SIGNING_SECRET=your-signing-secret

# App-level token para Socket Mode, começa com xapp- (Basic Information > App-Level Tokens)
SLACK_APP_TOKEN=xapp-your-app-level-token

# ID do canal onde os pedidos de ajuste serão publicados (ex: C0123456789)
TARGET_CHANNEL_ID=C0123456789

# Porta local usada pelo processo (Socket Mode não expõe HTTP publicamente,
# mas o Bolt ainda abre uma porta local)
PORT=3000

# Opcional: nome do slash command, caso queira mudar de /ajuste
# SLASH_COMMAND=/ajuste
